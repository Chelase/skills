{
  "$comment": "复制本文件为 config/nat-port-forward.config.json 后填写真实值。真实配置文件含凭据，已被 .gitignore 排除，不入库。",
  "publicIp": "203.0.113.10",
  "server": {
    "sshAlias": "web-server",
    "internalIp": "192.168.30.104",
    "note": "sshAlias 为 ~/.ssh/config 中的别名；无别名时用 user@host"
  },
  "layers": [
    {
      "id": "L1",
      "name": "最外层路由器",
      "model": "<路由器型号>",
      "adminUrl": "http://203.0.113.10:<管理端口>",
      "username": "admin",
      "password": "CHANGE_ME",
      "nextHopIp": "192.168.10.3",
      "note": "nextHopIp = L2 的 WAN 口 IP"
    },
    {
      "id": "L2",
      "name": "二层路由",
      "model": "<路由器型号>",
      "adminUrl": "http://192.168.20.1",
      "username": "",
      "password": "CHANGE_ME",
      "nextHopIp": "192.168.20.89",
      "note": "nextHopIp = L3 的 WAN 口 IP"
    },
    {
      "id": "L3",
      "name": "三层路由",
      "model": "<路由器型号>",
      "adminUrl": "http://192.168.30.1",
      "username": "admin",
      "password": "CHANGE_ME",
      "nextHopIp": "192.168.30.104",
      "note": "nextHopIp = 服务器内网 IP"
    }
  ],
  "ports": [
    {
      "name": "web",
      "external": 10080,
      "internal": 80,
      "targetIp": "192.168.30.104",
      "protocol": "ALL",
      "note": "站点 HTTP。外部端口用高位，避开运营商封禁的 80/443"
    }
  ],
  "blockedPorts": [
    { "port": 3306, "reason": "MySQL，禁止暴露公网" },
    { "port": 6379, "reason": "Redis，禁止暴露公网" }
  ]
}
